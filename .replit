modules = ["nodejs-20", "postgresql-16"]
run = "npm start"

[nix]
channel = "stable-24_05"

[deployment]
deploymentTarget = "autoscale"
build = ["npm", "install"]
run = ["npm", "start"]

[[ports]]
localPort = 5000
externalPort = 80

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=5000 npm start"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

# No PUBLIC_BASE_URL here, so a preview sends Beam buyers back to its own address.
# Set PUBLIC_BASE_URL=https://challenge.yaru.ai only when this app serves challenge.yaru.ai.
# Never set it to start.yaru.ai (that's the Thai site).
